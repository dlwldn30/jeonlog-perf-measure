+
+/** 인기 집계 캐시가 같은 조건의 반복 요청에서 집계 쿼리를 한 번만 실행하는지 확인한다. */
+class PopularRecommendationServiceCacheTest {
+
+    private final PopularRecommendationRepository repository = mock(PopularRecommendationRepository.class);
+    private final PopularRecommendationService service = new PopularRecommendationService(repository);
+
+    @Test
+    void 같은_조건으로_반복_호출하면_집계_쿼리는_한_번만_실행된다() {
+        when(repository.findTopPopularExhibitionIds(any(), any(), any(), any(), any(), anyDouble(), anyDouble(), any()))
+                .thenReturn(List.of());
+
+        service.getPopular(30, 1.0, 1.0);
+        service.getPopular(30, 1.0, 1.0);
+        service.getPopular(30, 1.0, 1.0);
+
+        verify(repository, times(1))
+                .findTopPopularExhibitionIds(any(), any(), any(), any(), any(), anyDouble(), anyDouble(), any());
+    }
+
+    @Test
+    void 조건이_다르면_캐시를_공유하지_않는다() {
+        when(repository.findTopPopularExhibitionIds(any(), any(), any(), any(), any(), anyDouble(), anyDouble(), any()))
+                .thenReturn(List.of());
+
+        service.getPopular(30, 1.0, 1.0);
+        service.getPopular(7, 1.0, 1.0);
+
+        verify(repository, times(2))
